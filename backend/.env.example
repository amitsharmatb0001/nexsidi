# ============================================================
# NexSidi v2 -- Local Development Environment
# ============================================================
# Copy to .env:  cp .env.example .env
# Fill in YOUR values below (DATABASE_URL + JWT_SECRET_KEY minimum)
#
# In PRODUCTION: all secrets come from GCP Secret Manager.
# This .env is ONLY for local development.
# ============================================================

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- Database (PostgreSQL) ---
# Point to your GCP Cloud SQL instance (or local postgres)
DATABASE_URL=postgresql+asyncpg://nexsidi_app:YOUR_PASSWORD@YOUR_DB_HOST:5432/nexsidi

# Admin URL for migrations (has DDL permissions -- CREATE TABLE etc)
DATABASE_ADMIN_URL=postgresql+asyncpg://nexsidi_admin:YOUR_ADMIN_PASSWORD@YOUR_DB_HOST:5432/nexsidi

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# --- JWT Auth (MUST be 32+ characters) ---
JWT_SECRET_KEY=change-this-to-a-64-char-random-string-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Valkey / Redis ---
VALKEY_URL=redis://localhost:6379/0
# VALKEY_PASSWORD=

# --- AI Providers ---
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...

# --- GCP (disabled in local dev) ---
USE_CLOUD_SECRETS=false
# GCP_PROJECT_ID=nexsidi-prod
# GCP_AI_PROJECT_ID=yugnex-ai

# --- Google OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Feature Flags ---
ENABLE_PHONE_OTP=false
ENABLE_TOTP=false
ENABLE_PASSKEYS=false
