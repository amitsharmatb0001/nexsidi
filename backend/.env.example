# === Database ===
DATABASE_URL=postgresql+asyncpg://nexsidi_app:changeme@localhost:5432/nexsidi
# Separate superuser URL for migrations only (never used by app)
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/nexsidi

# === Valkey (Redis-compatible) ===
VALKEY_URL=redis://localhost:6379/0
VALKEY_PASSWORD=

# === Auth ===
JWT_SECRET_KEY=change-this-to-a-64-char-random-string
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AI Providers ===
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# === CORS ===
CORS_ORIGINS=["http://localhost:3000"]

# === Environment ===
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# === Feature Flags (all auth features disabled by default) ===
ENABLE_PHONE_OTP=false
ENABLE_TOTP=false
ENABLE_PASSKEYS=false
