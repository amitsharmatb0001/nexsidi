{
  "info": {
    "name": "NexSidi v2 API",
    "description": "Complete API test collection for NexSidi v2.\n\nFlow:\n1. Register → get tokens\n2. Create project\n3. Start pipeline\n4. Create chat session → send message\n5. Check notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "access_token", "value": ""},
    {"key": "refresh_token", "value": ""},
    {"key": "project_id", "value": ""},
    {"key": "chat_session_id", "value": ""},
    {"key": "run_id", "value": ""}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{access_token}}"}]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "auth": {"type": "noauth"}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('healthy');",
                  "    pm.expect(json.version).to.eql('2.0.0');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amit@nexsidi.com\",\n  \"password\": \"Nexsidi2026!\",\n  \"name\": \"Amit Sharma\",\n  \"organization_name\": \"NexSidi\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "    pm.expect(json.refresh_token).to.be.a('string');",
                  "    pm.expect(json.token_type).to.eql('bearer');",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amit@nexsidi.com\",\n  \"password\": \"Nexsidi2026!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/refresh",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Get Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Me 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.email).to.include('@');",
                  "    pm.expect(json.role).to.eql('org_admin');",
                  "    pm.expect(json.is_active).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "2.1 Create Project",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/projects/",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My SaaS App\",\n  \"description\": \"AI-powered SaaS application built with NexSidi\",\n  \"tech_stack\": {\n    \"frontend\": \"Next.js\",\n    \"backend\": \"FastAPI\",\n    \"database\": \"PostgreSQL\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Project created 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('My SaaS App');",
                  "    pm.collectionVariables.set('project_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 List Projects",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/projects/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Projects listed', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.total).to.be.above(0);",
                  "    pm.expect(json.projects).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Get Project",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/projects/{{project_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Project found', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get('project_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Update Project",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/v1/projects/{{project_id}}",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My SaaS App v2\",\n  \"description\": \"Updated description with AI agents\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Project updated', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('My SaaS App v2');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Pipeline",
      "item": [
        {
          "name": "3.1 Start Pipeline (checkpoint mode)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/pipeline/start",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"execution_mode\": \"checkpoint\",\n  \"requirements\": \"Build a task management SaaS with user auth, Kanban board, real-time updates via WebSocket, and Razorpay billing.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Pipeline started 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.be.a('string');",
                  "    pm.expect(json.execution_mode).to.eql('checkpoint');",
                  "    pm.collectionVariables.set('run_id', json.run_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Get Pipeline Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/pipeline/{{run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Pipeline status OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.run_id).to.eql(pm.collectionVariables.get('run_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Approve Checkpoint",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/pipeline/{{run_id}}/approve",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"feedback\": \"Design looks good, proceed to build phase.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Checkpoint approved', function() {",
                  "    // 200 if paused, 400 if not paused (both valid)",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Chat (AI model calls)",
      "item": [
        {
          "name": "4.1 Create Chat Session",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/chat/sessions/{{project_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Session created 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.channel).to.eql('web');",
                  "    pm.expect(json.status).to.eql('active');",
                  "    pm.collectionVariables.set('chat_session_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Send Chat Message",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/chat/session/{{chat_session_id}}/messages",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Build a user authentication system with Google OAuth and email/password login. Include JWT token refresh.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Message sent 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.role).to.eql('user');",
                  "    pm.expect(json.content).to.include('authentication');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Get Chat Messages",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/chat/session/{{chat_session_id}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Messages fetched', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.4 List Chat Sessions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/chat/sessions/{{project_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Sessions listed', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.total).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Notifications",
      "item": [
        {
          "name": "5.1 Get Notifications",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/notifications/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Notifications 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Error Cases",
      "item": [
        {
          "name": "6.1 Auth required (no token)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/projects/",
            "auth": {"type": "noauth"}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized 401/403', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Register duplicate email",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amit@nexsidi.com\",\n  \"password\": \"Nexsidi2026!\",\n  \"name\": \"Duplicate User\",\n  \"organization_name\": \"Dup Org\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Conflict 409', function() {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.3 Login wrong password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amit@nexsidi.com\",\n  \"password\": \"WrongPassword1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized 401', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.4 Weak password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "auth": {"type": "noauth"},
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"weak@test.com\",\n  \"password\": \"weak\",\n  \"name\": \"Weak\",\n  \"organization_name\": \"Test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validation error 422', function() {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
